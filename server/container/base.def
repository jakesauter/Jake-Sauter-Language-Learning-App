Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

# Heavy, slow-changing dependencies. Build once:
#   APPTAINER_TMPDIR=/mnt/storage/tmp/apptainer apptainer build --fakeroot container/base.sif container/base.def
#   (the scratch folder must be on a big disk: /tmp is RAM and too small for torch)

%files
    container/requirements.txt /opt/requirements.txt
    container/constraints.txt /opt/constraints.txt

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -q
    apt-get install -y -q --no-install-recommends python3 python3-venv python3-pip ffmpeg ca-certificates
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir -q --upgrade pip
    /opt/venv/bin/pip install --no-cache-dir -q torch==2.11.0 torchaudio==2.11.0 --index-url https://download.pytorch.org/whl/cu128
    /opt/venv/bin/pip install --no-cache-dir -q -r /opt/requirements.txt -c /opt/constraints.txt  # same versions as the last build
    # FireRedASR2-AED recognizer and FireRedPunc punctuation code (Xiaohongshu, Apache-2.0), pinned to one commit.
    # The rest of that project (its own VAD, language ID, LLM variant) is not used.
    firered_commit=4e7d9aaf4482a47cec1724807026b9b151926eb5
    /opt/venv/bin/python -c "import io, sys, tarfile, urllib.request; tarfile.open(fileobj=io.BytesIO(urllib.request.urlopen(sys.argv[1]).read())).extractall('/tmp/firered', filter='data')" \
        "https://github.com/FireRedTeam/FireRedASR2S/archive/$firered_commit.tar.gz"
    mkdir -p /opt/firered && mv /tmp/firered/FireRedASR2S-$firered_commit/fireredasr2s/fireredasr2 /tmp/firered/FireRedASR2S-$firered_commit/fireredasr2s/fireredpunc /opt/firered/
    cp /tmp/firered/FireRedASR2S-$firered_commit/LICENSE /opt/firered/LICENSE && rm -rf /tmp/firered
    /opt/venv/bin/pip freeze > /opt/requirements.lock
    chmod -R a+rX /opt/venv /opt/firered
